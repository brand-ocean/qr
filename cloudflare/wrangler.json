{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viralsgame",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "viralsgame.nl/*", "zone_name": "viralsgame.nl" },
    { "pattern": "www.viralsgame.nl/*", "zone_name": "viralsgame.nl" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_STORE_URL": "https://apps.apple.com/",
    "PLAY_STORE_URL": "https://play.google.com/store/apps/details?id=nl.viralsgame.app",
    "REPORT_EMAIL_TO": "info@brandocean.nl",
    "CONVEX_URL": "https://tacit-crab-381.eu-west-1.convex.cloud"
  }
}
